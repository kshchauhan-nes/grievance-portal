# Copy to .env and edit. Never commit .env.
# Flask does not load .env by itself: export these variables in your shell
# or process manager (see README.md).

# "development" (default) or "production".
APP_ENV=development

# REQUIRED when APP_ENV=production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value

# SQLite file path (default: complaints.db in the project folder).
DATABASE_PATH=complaints.db

# Optional: creates the three demo authority accounts
# (school_authority, hospital_authority, ncc_authority) ONLY if they do not
# exist yet. Minimum 10 characters. Leave unset to create none.
# SEED_AUTHORITY_PASSWORD=choose-a-strong-password

# Secure cookies default to on in production, off in development.
# COOKIE_SECURE=1

# Seconds between lazy escalation checks (default 600). 0 disables the lazy
# check; then schedule `flask --app app run-escalation` yourself.
# ESCALATION_INTERVAL_SECONDS=600

# Development only: set to 1 for the Flask debugger when running `python app.py`.
# FLASK_DEBUG=0
